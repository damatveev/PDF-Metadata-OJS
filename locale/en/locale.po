msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: en\n"

msgid "plugins.generic.pdfMetadata.name"
msgstr "Metadata from PDF"
msgid "plugins.generic.pdfMetadata.description"
msgstr "Extract suggestions from a submission PDF locally. Review and select the values before saving."
msgid "plugins.generic.pdfMetadata.load"
msgstr "Open metadata assistant"
msgid "plugins.generic.pdfMetadata.extract"
msgstr "Extract suggestions"
msgid "plugins.generic.pdfMetadata.apply"
msgstr "Save selected changes"
msgid "plugins.generic.pdfMetadata.file"
msgstr "Submission PDF"
msgid "plugins.generic.pdfMetadata.locale"
msgstr "Language for title, abstract and keywords"
msgid "plugins.generic.pdfMetadata.current"
msgstr "Current values"
msgid "plugins.generic.pdfMetadata.proposed"
msgstr "Proposed value — editable"
msgid "plugins.generic.pdfMetadata.select"
msgstr "Replace this field with the proposed value"
msgid "plugins.generic.pdfMetadata.title"
msgstr "Title"
msgid "plugins.generic.pdfMetadata.abstract"
msgstr "Abstract"
msgid "plugins.generic.pdfMetadata.keywords"
msgstr "Keywords — one per line"
msgid "plugins.generic.pdfMetadata.doi"
msgstr "Article DOI"
msgid "plugins.generic.pdfMetadata.references"
msgstr "References"
msgid "plugins.generic.pdfMetadata.authors"
msgstr "Authors"
msgid "plugins.generic.pdfMetadata.affiliations"
msgstr "Add affiliations only — one institution per line"
msgid "plugins.generic.pdfMetadata.givenName"
msgstr "Given name"
msgid "plugins.generic.pdfMetadata.familyName"
msgstr "Family name"
msgid "plugins.generic.pdfMetadata.email"
msgstr "Email (required by OJS)"
msgid "plugins.generic.pdfMetadata.addAuthor"
msgstr "Add a mapping row"
msgid "plugins.generic.pdfMetadata.skip"
msgstr "Skip — do not change this author"
msgid "plugins.generic.pdfMetadata.newAuthor"
msgstr "Create a new author"
msgid "plugins.generic.pdfMetadata.mapping"
msgstr "Match to an existing author or create a new one"
msgid "plugins.generic.pdfMetadata.group"
msgstr "Contributor role"
msgid "plugins.generic.pdfMetadata.busy"
msgstr "Processing… please wait."
msgid "plugins.generic.pdfMetadata.saved"
msgstr "Selected changes saved. Close and reopen the workflow to refresh the other forms."
msgid "plugins.generic.pdfMetadata.review"
msgstr "These are suggestions. Check the article language, author names, email addresses and DOI carefully. No field is selected by default. References replace the entire reference list."
msgid "plugins.generic.pdfMetadata.empty"
msgstr "No original submission PDFs found. Upload a PDF through the OJS submission file manager first."
msgid "plugins.generic.pdfMetadata.reload"
msgstr "Reload"
msgid "plugins.generic.pdfMetadata.source"
msgstr "Source"
msgid "plugins.generic.pdfMetadata.confidence"
msgstr "Heuristic confidence (not a probability)"
msgid "plugins.generic.pdfMetadata.authorHelp"
msgstr "Names are not split automatically. Choose an existing author or create one, then enter given name, family name and email. Author data is saved in the submission's primary language. Existing authors are never removed."
msgid "plugins.generic.pdfMetadata.affiliationHelp"
msgstr "Detected institutions are listed below. Copy only the matching institutions into each author's row. New affiliations are appended; existing affiliations and ROR records are preserved."
msgid "plugins.generic.pdfMetadata.error"
msgstr "The operation could not be completed. Ask the administrator to check the plugin log."
msgid "plugins.generic.pdfMetadata.warning"
msgstr "Check this result"
msgid "plugins.generic.pdfMetadata.text"
msgstr "Extracted text for manual verification (first 30,000 characters)"
msgid "plugins.generic.pdfMetadata.noText"
msgstr "Little or no searchable text was found. For a scanned PDF, perform OCR locally, upload the searchable PDF in OJS, then try again. Embedded metadata may still be available."
msgid "plugins.generic.pdfMetadata.partial"
msgstr "Partial extraction: only the first 50 pages are processed, or one extraction method failed. Verify completeness, especially references."
msgid "plugins.generic.pdfMetadata.unavailable"
msgstr "Local extraction is unavailable. Configure Poppler and prlimit on the Linux server."
msgid "plugins.generic.pdfMetadata.invalidPdf"
msgstr "The PDF is invalid, encrypted, unreadable, or could not be processed."
msgid "plugins.generic.pdfMetadata.limit"
msgstr "Processing limit reached: maximum PDF size 20 MiB, bounded processing time and output size."
msgid "plugins.generic.pdfMetadata.expired"
msgstr "The review session expired or is invalid. Extract the suggestions again."
msgid "plugins.generic.pdfMetadata.conflict"
msgstr "The publication or source PDF changed after extraction. Reload and extract again before saving."
msgid "plugins.generic.pdfMetadata.forbidden"
msgstr "Access denied. Only permitted editorial staff may edit the latest unpublished draft in this journal."
msgid "plugins.generic.pdfMetadata.validation"
msgstr "Check the selected fields and author data. OJS validation requirements must be satisfied."
msgid "plugins.generic.pdfMetadata.doiExists"
msgstr "A DOI is already assigned. This assistant does not replace existing DOI records; manage them through the OJS DOI interface."
msgid "plugins.generic.pdfMetadata.configuration"
msgstr "The administrator must configure a private temporary directory and a strong plugin secret."
msgid "plugins.generic.pdfMetadata.selectFields"
msgstr "Select at least one field or author change."
