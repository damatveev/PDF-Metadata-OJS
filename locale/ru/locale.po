msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ru\n"

msgid "plugins.generic.pdfMetadata.name"
msgstr "Метаданные из PDF"
msgid "plugins.generic.pdfMetadata.description"
msgstr "Локальное извлечение метаданных из PDF материала. Проверьте и выберите значения перед сохранением."
msgid "plugins.generic.pdfMetadata.load"
msgstr "Открыть помощник метаданных"
msgid "plugins.generic.pdfMetadata.extract"
msgstr "Извлечь метаданные"
msgid "plugins.generic.pdfMetadata.apply"
msgstr "Сохранить выбранные изменения"
msgid "plugins.generic.pdfMetadata.file"
msgstr "PDF материала"
msgid "plugins.generic.pdfMetadata.locale"
msgstr "Язык названия, аннотации и ключевых слов"
msgid "plugins.generic.pdfMetadata.current"
msgstr "Текущие значения"
msgid "plugins.generic.pdfMetadata.proposed"
msgstr "Предлагаемое значение — можно исправить"
msgid "plugins.generic.pdfMetadata.select"
msgstr "Заменить это поле предлагаемым значением"
msgid "plugins.generic.pdfMetadata.title"
msgstr "Название"
msgid "plugins.generic.pdfMetadata.abstract"
msgstr "Аннотация"
msgid "plugins.generic.pdfMetadata.keywords"
msgstr "Ключевые слова — по одному на строке"
msgid "plugins.generic.pdfMetadata.doi"
msgstr "DOI статьи"
msgid "plugins.generic.pdfMetadata.references"
msgstr "Список литературы"
msgid "plugins.generic.pdfMetadata.authors"
msgstr "Авторы"
msgid "plugins.generic.pdfMetadata.affiliations"
msgstr "Только добавление аффилиаций — по одной организации на строке"
msgid "plugins.generic.pdfMetadata.givenName"
msgstr "Имя и отчество"
msgid "plugins.generic.pdfMetadata.familyName"
msgstr "Фамилия"
msgid "plugins.generic.pdfMetadata.email"
msgstr "Электронная почта (обязательна в OJS)"
msgid "plugins.generic.pdfMetadata.addAuthor"
msgstr "Добавить строку сопоставления"
msgid "plugins.generic.pdfMetadata.skip"
msgstr "Пропустить — не изменять автора"
msgid "plugins.generic.pdfMetadata.newAuthor"
msgstr "Создать нового автора"
msgid "plugins.generic.pdfMetadata.mapping"
msgstr "Сопоставить с существующим автором или создать нового"
msgid "plugins.generic.pdfMetadata.group"
msgstr "Роль участника публикации"
msgid "plugins.generic.pdfMetadata.busy"
msgstr "Обработка… пожалуйста, подождите."
msgid "plugins.generic.pdfMetadata.saved"
msgstr "Выбранные изменения сохранены. Закройте и снова откройте рабочий процесс, чтобы обновить остальные формы."
msgid "plugins.generic.pdfMetadata.review"
msgstr "Это предположения. Проверьте язык статьи, имена, адреса авторов и DOI. По умолчанию ни одно поле не выбрано. Список литературы заменяется целиком."
msgid "plugins.generic.pdfMetadata.empty"
msgstr "PDF среди исходных файлов материала не найден. Сначала загрузите PDF через файловый менеджер материала в OJS."
msgid "plugins.generic.pdfMetadata.reload"
msgstr "Обновить"
msgid "plugins.generic.pdfMetadata.source"
msgstr "Источник"
msgid "plugins.generic.pdfMetadata.confidence"
msgstr "Эвристическая уверенность (не вероятность)"
msgid "plugins.generic.pdfMetadata.authorHelp"
msgstr "Имя и фамилия не разделяются автоматически. Выберите существующего автора или создание нового, затем укажите имя, фамилию и почту. Данные авторов сохраняются на основном языке материала. Существующие авторы не удаляются."
msgid "plugins.generic.pdfMetadata.affiliationHelp"
msgstr "Ниже перечислены найденные организации. Скопируйте подходящие в строку соответствующего автора. Аффилиации добавляются; существующие организации и записи ROR сохраняются."
msgid "plugins.generic.pdfMetadata.error"
msgstr "Не удалось завершить операцию. Попросите администратора проверить журнал плагина."
msgid "plugins.generic.pdfMetadata.warning"
msgstr "Проверьте результат"
msgid "plugins.generic.pdfMetadata.text"
msgstr "Извлечённый текст для проверки (первые 30 000 символов)"
msgid "plugins.generic.pdfMetadata.noText"
msgstr "Доступного для поиска текста мало или нет. Для скана выполните OCR локально, загрузите PDF с текстовым слоем в OJS и повторите попытку. Встроенные метаданные могут быть доступны."
msgid "plugins.generic.pdfMetadata.partial"
msgstr "Извлечение частичное: обрабатываются только первые 50 страниц либо один из способов извлечения не сработал. Проверьте полноту, особенно список литературы."
msgid "plugins.generic.pdfMetadata.unavailable"
msgstr "Локальное извлечение недоступно. Настройте Poppler и prlimit на сервере Linux."
msgid "plugins.generic.pdfMetadata.invalidPdf"
msgstr "PDF повреждён, зашифрован, недоступен для чтения или не поддаётся обработке."
msgid "plugins.generic.pdfMetadata.limit"
msgstr "Достигнут предел обработки: PDF не более 20 МиБ, время обработки и объём извлечённого текста ограничены."
msgid "plugins.generic.pdfMetadata.expired"
msgstr "Сеанс просмотра истёк или недействителен. Извлеките метаданные заново."
msgid "plugins.generic.pdfMetadata.conflict"
msgstr "Публикация или исходный PDF изменились после извлечения. Обновите данные и повторите извлечение перед сохранением."
msgid "plugins.generic.pdfMetadata.forbidden"
msgstr "Нет доступа. Изменять последний неопубликованный черновик могут только сотрудники редакции с необходимыми правами в этом журнале."
msgid "plugins.generic.pdfMetadata.validation"
msgstr "Проверьте выбранные поля и данные авторов. Необходимо выполнить требования валидации OJS."
msgid "plugins.generic.pdfMetadata.doiExists"
msgstr "DOI уже назначен. Помощник не заменяет существующие DOI; управляйте ими через штатный интерфейс DOI в OJS."
msgid "plugins.generic.pdfMetadata.configuration"
msgstr "Администратору нужно настроить закрытый временный каталог и надёжный секрет плагина."
msgid "plugins.generic.pdfMetadata.selectFields"
msgstr "Выберите хотя бы одно поле или изменение автора."
